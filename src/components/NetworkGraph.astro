---
interface Props {
  height?: string;
  density?: number;
}
const { height = "560px", density = 42 } = Astro.props;
---

<div class="graph-wrap" style={`height:${height}`}>
  <canvas id="vm-graph" data-density={density} aria-hidden="true"></canvas>
</div>

<style>
  .graph-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    overflow: hidden;
  }
  canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  const canvas = document.getElementById("vm-graph") as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext("2d");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const density = parseInt(canvas.dataset.density || "42", 10);

    let w = 0, h = 0, dpr = Math.min(window.devicePixelRatio || 1, 2);
    let nodes: { x: number; y: number; vx: number; vy: number; r: number; pulse: number }[] = [];

    const INK = "14, 17, 22";
    const ACCENT = "59, 53, 214";
    const PULSE = "20, 184, 166";

    function resize() {
      if (!canvas) return;
      const rect = canvas.parentElement!.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function seed() {
      nodes = Array.from({ length: density }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.18,
        vy: (Math.random() - 0.5) * 0.18,
        r: Math.random() * 1.6 + 1.2,
        pulse: Math.random() * Math.PI * 2,
      }));
    }

    function frame() {
      if (!ctx) return;
      ctx.clearRect(0, 0, w, h);
      const linkDist = Math.max(w, h) * 0.11;

      for (const n of nodes) {
        n.x += n.vx;
        n.y += n.vy;
        if (n.x < -20) n.x = w + 20; else if (n.x > w + 20) n.x = -20;
        if (n.y < -20) n.y = h + 20; else if (n.y > h + 20) n.y = -20;
        n.pulse += 0.008;
      }

      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const a = nodes[i], b = nodes[j];
          const dx = a.x - b.x, dy = a.y - b.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < linkDist) {
            const alpha = (1 - dist / linkDist) * 0.28;
            ctx.strokeStyle = `rgba(${ACCENT}, ${alpha})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
          }
        }
      }

      for (const n of nodes) {
        const glow = (Math.sin(n.pulse) + 1) / 2;
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r + glow * 0.6, 0, Math.PI * 2);
        ctx.fillStyle = glow > 0.85 ? `rgba(${PULSE}, 0.9)` : `rgba(${INK}, 0.55)`;
        ctx.fill();
      }

      if (!reduceMotion) requestAnimationFrame(frame);
    }

    resize();
    seed();
    frame();

    let resizeTimer: number;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        resize();
        seed();
        if (reduceMotion) frame();
      }, 150);
    });
  }
</script>
