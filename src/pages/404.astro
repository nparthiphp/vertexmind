---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found">
  <section class="not-found">
    <div class="wrap">
      <span class="eyebrow">404</span>
      <h1>This route doesn't exist.</h1>
      <p>The page you're looking for was moved or never built. Head back to the homepage.</p>
      <a href="/" class="btn btn-primary btn-arrow">Back home</a>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    min-height: 60vh;
    display: flex;
    align-items: center;
    padding: 80px 0;
  }
  .not-found h1 {
    font-size: clamp(28px, 4vw, 42px);
    margin-top: 14px;
  }
  .not-found p {
    margin-top: 16px;
    color: var(--ink-soft);
    max-width: 480px;
  }
  .not-found .btn {
    margin-top: 28px;
  }
</style>
